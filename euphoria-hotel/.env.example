# Supabase - required for production persistence and real admin auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Paystack - required for live online payments
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Email option A: SMTP for demos or business email/cPanel/Zoho/Gmail app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=bookings@hiltoneuphoriahotel.com

# Email option B: Resend for production transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@hiltoneuphoriahotel.com

# Optional rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel cron protection
CRON_SECRET=

